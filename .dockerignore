# Keep the build context small and free of host state. The image installs from
# pyproject.toml + uv.lock and copies only src/, config/, data/, README.md.
.venv/
**/__pycache__/
*.py[cod]
.git/
.gitignore
.pytest_cache/
.ruff_cache/
.pyright/
*.db
.env
dist/
build/
*.egg-info/
tests/
docs/
Dockerfile
.dockerignore
docker-compose.yml
