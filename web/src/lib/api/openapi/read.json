    },
    "/alerts/{alert_id}/detections": {
      "get": {
        "summary": "Alert Detections",
        "description": "Drill-down: the evidence behind one alert.",
        "operationId": "alert_detections_alerts__alert_id__detections_get",
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Alert Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DetectionResult"
                  },
                  "title": "Response Alert Detections Alerts  Alert Id  Detections Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/malformed": {
      "get": {
        "summary": "Malformed",
        "description": "The audit view: inputs that failed normalization (never dropped).",
        "operationId": "malformed_malformed_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 1,
              "default": 1000,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "How many rows to skip. Every list ordering here is total (each ends in a unique id), so paging cannot skip or repeat a row. Read X-Total-Count to learn whether more remain.",
              "default": 0,
              "title": "Offset"
            },
            "description": "How many rows to skip. Every list ordering here is total (each ends in a unique id), so paging cannot skip or repeat a row. Read X-Total-Count to learn whether more remain."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MalformedRecord"
                  },
                  "title": "Response Malformed Malformed Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/summary": {
      "get": {
        "summary": "Summary",
        "operationId": "summary_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Summary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertSeverity": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical",
          "emergency"
        ],
        "title": "AlertSeverity",
        "description": "Analyst-facing alert severity (five labels, driven by absolute priority score)."
      },
      "AlertStatus": {
        "type": "string",
        "enum": [
          "new",
          "acknowledged",
          "closed"
        ],
        "title": "AlertStatus",
        "description": "Minimal triage workflow state."
      },
      "Asset": {
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "title": "Asset Id",
            "description": "Natural key as it appears in raw data"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "asset_type": {
            "type": "string",
            "minLength": 1,
            "title": "Asset Type",
            "description": "e.g. \"pump\", \"gateway\", \"plc\""
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location"
          },
          "criticality": {
            "$ref": "#/components/schemas/Criticality",
            "default": "medium"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "asset_id",
          "name",
          "asset_type"
        ],
        "title": "Asset",
        "description": "A monitored device or system \u2014 the 'who' everything is correlated on."
      },
      "Criticality": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Criticality",
        "description": "How much an asset matters \u2014 feeds the prioritizer's device weight."
      },
      "DetectionResult": {
        "properties": {
          "window_start": {
            "type": "string",
            "format": "date-time",
            "title": "Window Start"
          },
          "window_end": {
            "type": "string",
            "format": "date-time",
            "title": "Window End"
          },
          "detection_id": {
            "type": "string",
            "format": "uuid",
            "title": "Detection Id"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "title": "Asset Id"
          },
          "lane": {
            "$ref": "#/components/schemas/Lane"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "title": "Method",
            "description": "Detector name, e.g. \"lstm_ae\""
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "event_kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "window_start",
          "window_end",
          "asset_id",
          "lane",
          "method",
          "score",
          "threshold"
        ],
        "title": "DetectionResult",
        "description": "A detector's positive judgment about an asset over a time window.\n\n``score`` and ``threshold`` are the method's raw values; scores are not\ncomparable across methods \u2014 downstream consumers reason about the margin.\nContributing events are recoverable by an inclusive-window query on\n(asset_id, window_start..window_end, lane) \u2014 the bound must be closed, since\na point anomaly is a zero-length window; they are not stored inline\n(ADR-0003 D4)."
      },
      "EventKind": {
        "type": "string",
        "enum": [
          "point",
          "contextual",
          "collective"
        ],
        "title": "EventKind",
        "description": "Shape of a detected anomaly episode (from run-length of consecutive windows)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Lane": {
        "type": "string",
        "enum": [
          "telemetry",
          "log",
          "flow"
        ],
        "title": "Lane",
        "description": "Detection modality \u2014 which specialist lane an event or detection belongs to."
      },
      "MalformedRecord": {
        "properties": {
          "record_id": {
            "type": "string",
            "format": "uuid",
            "title": "Record Id"
          },
          "raw": {
            "type": "string",
            "title": "Raw",
            "description": "Original record verbatim"
          },
          "error": {
            "type": "string",
            "minLength": 1,
            "title": "Error",
            "description": "Why normalization rejected it"
          },
          "source_format": {
            "type": "string",
            "minLength": 1,
            "title": "Source Format"
          },
          "origin": {
            "type": "string",
            "minLength": 1,
            "title": "Origin",
            "description": "Provenance, e.g. file path or stream name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "raw",
          "error",
          "source_format",
          "origin"
        ],
        "title": "MalformedRecord",
        "description": "An input record that failed normalization \u2014 captured, never dropped (ADR-0004).\n\nNormalization is the trust boundary: unparseable input is expected, frequent,\nand disproportionately suspicious, so failure is modeled as data, not as logs."
      },
      "NormalizedEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "title": "Asset Id"
          },
          "source_type": {
            "$ref": "#/components/schemas/Lane"
          },
          "source_format": {
            "type": "string",
            "minLength": 1,
            "title": "Source Format",
            "description": "Fine-grained origin, e.g. \"syslog\""
          },
          "metric": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metric",
            "description": "Channel/action name, e.g. \"Pressure\""
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity",
            "default": "info"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "raw": {
            "type": "string",
            "title": "Raw",
            "description": "Original record verbatim, for evidence and audit"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "asset_id",
          "source_type",
          "source_format",
          "raw"
        ],
        "title": "NormalizedEvent",
        "description": "One normalized observation: the shared envelope every raw record becomes.\n\nOne numeric value per event (ADR-0003 D1): a multivariate reading fans out\ninto one event per metric; detector adapters pivot back as needed."
      },
      "PrioritizedAlert": {
        "properties": {
          "window_start": {
            "type": "string",
            "format": "date-time",
            "title": "Window Start"
          },
          "window_end": {
            "type": "string",
            "format": "date-time",
            "title": "Window End"
          },
          "alert_id": {
            "type": "string",
            "format": "uuid",
            "title": "Alert Id"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1,
            "title": "Asset Id"
          },
          "severity": {
            "$ref": "#/components/schemas/AlertSeverity"
          },
          "priority_score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Priority Score"
          },
          "threat_class": {
            "type": "string",
            "title": "Threat Class",
            "default": "unknown"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "title": "Rationale",
            "description": "Human-readable why, always present"
          },
          "score_components": {
            "additionalProperties": true,
            "type": "object",
            "title": "Score Components"
          },
          "detection_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "minItems": 1,
            "title": "Detection Ids"
          },
          "recommended_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommended Action"
          },
          "status": {
            "$ref": "#/components/schemas/AlertStatus",
            "default": "new"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "window_start",
          "window_end",
          "asset_id",
          "severity",
          "priority_score",
          "rationale",
          "detection_ids"
        ],
        "title": "PrioritizedAlert",
