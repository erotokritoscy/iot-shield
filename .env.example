# Copy to .env and adjust. .env is gitignored — never commit real secrets.
# These match the compose defaults, so the stack behaves identically whether or
# not you create .env; change the password for anything beyond local use.
POSTGRES_USER=iotshield
POSTGRES_PASSWORD=iotshield
POSTGRES_DB=iotshield
# Host port Postgres is published on (127.0.0.1 only), for a DB client on the host.
# Change it if something on the host already listens on 5432.
POSTGRES_HOST_PORT=5432

# Passwords for the source databases in config/connections.yaml (ADR-0042). Unset, that
# connection reports "no password configured" and nothing else is affected.
SENSIPRO_DB_PASSWORD=
BIOLOGY_DB_PASSWORD=

# HTTP API data sources (ADR-0049). The key encrypts the credentials org admins enter for an
# API source; without it such a source cannot be saved. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes stored API credentials unreadable (each source then asks for them again).
IOTSHIELD_SECRET_KEY=
# Hosts the server may call although they resolve to a private address, comma-separated
# (http:// is allowed only for these). Leave empty to allow public https APIs only.
IOTSHIELD_API_ALLOWED_HOSTS=
