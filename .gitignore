# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Environments
.venv/
.env

# Tool caches
.pytest_cache/
.ruff_cache/
.pyright/

# Local artifacts (generated models, run outputs, local demo databases)
artifacts/
# ...but committed, trained model artifacts (source of truth, shipped in the
# wheel) are the exception, not transient output (ADR-0012).
!src/iotshield/detect/team3/artifacts/
logs/
*.db

# File-sink output (JSONL): run outputs, not source. The compose stack mounts
# ./results into the Pipeline API; CLI runs default to ./iotshield-results.jsonl (ADR-0018).
results/
# The extension is banned everywhere rather than just in those two places, because a host run
# honours any `sinks[].params.path` as given — output can land anywhere.
*.jsonl
# ...so the exemption is stated on the axis that actually distinguishes them: JSONL under
# data/ and tests/ is SOURCE, not output. Recursive on purpose — the pass-through normalizer's
# demo feed is JSONL by nature (ADR-0025) and the next one may sit a directory deeper. Fetched
# corpora stay ignored through data/eval/skab_*/ below, since a file cannot be re-included once
# a parent directory is excluded.
!data/**/*.jsonl
!tests/**/*.jsonl

# Benchmark reports: generated by `python -m iotshield.eval --out` (ADR-0021). The labelled
# corpora under data/eval/ ARE source and stay committed; what a run scores is not.
reports/

# Fetched corpora: datasets we may USE but not REDISTRIBUTE (SKAB is GPLv3, and this repo
# declares no licence). `iotshield.eval fetch skab` rebuilds them locally in seconds; the
# corpora we own — data/eval/synthetic — are committed and stay that way (ADR-0021 D5).
data/eval/skab_*/

# OS noise
.DS_Store
Thumbs.db
